{
  "name": "jogo-mobile",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build:web": "npm --prefix ../cliente run build",
    "configure:api": "node scripts/configure-api.mjs",
    "android:add": "npm run build:web && npm run configure:api && cap add android",
    "android:sync": "npm run build:web && npm run configure:api && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0"
  }
}
